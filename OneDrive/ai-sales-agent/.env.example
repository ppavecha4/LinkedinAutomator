══ ANTHROPIC ═══════════════════════════════
ANTHROPIC_API_KEY=                    # console.anthropic.com → API Keys
══ AWS ══════════════════════════════════════
AWS_ACCESS_KEY_ID=                    # IAM user with programmatic access
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
══ EMAIL — provider switch ═══════════════════
# Pick the email backend. Options:
#   google_workspace  → SMTP relay via smtp.gmail.com:587 with App Password
#                       (recommended for new operators — 5-min setup,
#                       inherits your mailbox reputation)
#   ses               → Amazon SES v2 via boto3 (production-scale path)
# If unset, auto-detects from which credentials are populated below.
EMAIL_PROVIDER=google_workspace

══ EMAIL — Google Workspace SMTP ═════════════
GOOGLE_WORKSPACE_EMAIL=               # you@your-workspace-domain.com
GOOGLE_WORKSPACE_APP_PASSWORD=        # 16-char from myaccount.google.com/apppasswords
GOOGLE_WORKSPACE_FROM_NAME=           # "First Last" — display name on outbound
GOOGLE_WORKSPACE_REPLY_TO=            # optional; defaults to GOOGLE_WORKSPACE_EMAIL

# Email open tracking (opt-in — keep OFF for cold first-touch sends
# to preserve deliverability; turn ON for warm replies / follow-ups
# to known engaged contacts where 3–5% extra spam risk is acceptable).
# The pixel hits {EMAIL_TRACKING_BASE_URL}/track/open/{message_id}.gif
# which MUST be publicly reachable — Gmail can't fetch localhost.
# For local dev use a cloudflared tunnel to expose the API.
EMAIL_TRACK_OPENS=false               # true | false
EMAIL_TRACKING_BASE_URL=              # e.g. https://abc123.trycloudflare.com

══ EMAIL — Amazon SES (alternative) ══════════
SES_FROM_EMAIL=                       # Verified sender in SES console
SES_FROM_NAME=                        # Display name
SES_CONFIGURATION_SET=sales-agent     # Created by deploy script
UNSUBSCRIBE_BASE_URL=                 # https://yourdomain.com (used by both providers)
══ WHATSAPP — Twilio ═════════════════════════
TWILIO_ACCOUNT_SID=                   # console.twilio.com
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=                 # whatsapp:+14155238886
TWILIO_WEBHOOK_URL=                   # Set after first deploy
══ LINKEDIN — channel mode ═══════════════════
# draft     → operator manually click-sends from the LinkedIn Drafts
#             queue. Works with ANY LinkedIn account. Default.
# heyreach  → delegate to Heyreach Sales (browser automation SaaS).
#             Real automation, $50–200/mo, no MDP review needed.
# api       → direct LinkedIn Sales Navigator API. Requires Marketing
#             Developer Platform partnership (4–8 wk review, gated).
LINKEDIN_MODE=draft

══ LINKEDIN — API mode (when MDP-approved) ═══
LINKEDIN_CLIENT_ID=                   # LinkedIn Developer Portal
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=                # OAuth2 — see docs/linkedin-setup.md
LINKEDIN_PERSON_URN=                  # urn:li:person:XXXXXXXX

══ LINKEDIN — Heyreach mode (SaaS automation) ═
# Public API key from your Heyreach account settings.
HEYREACH_API_KEY=
# Default campaign id for first-touch (connection requests). Operator
# pre-configures this campaign in Heyreach with body template that
# references {{customField1}} so our AI-personalised text is used verbatim.
HEYREACH_CAMPAIGN_ID=
# Optional: separate campaign id used when send_message() fires the
# follow-up DM. If unset, falls back to HEYREACH_CAMPAIGN_ID — your
# Heyreach sequence should then cover both steps.
HEYREACH_CAMPAIGN_ID_FOLLOWUP=
# Required as of June 2026 — Heyreach's AddLeadsToCampaign now needs
# `accountLeadPairs`, pairing each lead with a specific connected
# LinkedIn account id. Fetch via:
#   curl -X POST https://api.heyreach.io/api/public/li_account/GetAll \
#     -H "X-API-KEY: $HEYREACH_API_KEY" -H "Content-Type: application/json" \
#     -d '{"offset":0,"limit":10}'
# Use the integer `id` field from the first account in `items`.
HEYREACH_LINKEDIN_ACCOUNT_ID=

# Optional: when set, POST /api/campaigns auto-creates a matching
# Heyreach campaign by CLONING this template (uses Heyreach's
# /campaign/CreateCampaignFromTemplate endpoint). The template should
# have your sequence, LinkedIn account, and {{customField1}} body
# template pre-configured in the Heyreach UI. Leave empty to skip
# templated clone — auto-create will fall back to a blank campaign,
# which means you'll need to finish sequence config in Heyreach UI
# before pushing leads.
HEYREACH_TEMPLATE_CAMPAIGN_ID=
══ PROSPECT ENRICHMENT ════════════════════════
APOLLO_API_KEY=                       # app.apollo.io → Settings → API Keys
══ MEETING BOOKING ════════════════════════════
CALENDLY_API_KEY=                     # calendly.com/integrations/api
CALENDLY_EVENT_TYPE_URI=              # Full URI of your event type
CALENDLY_WEBHOOK_SIGNING_KEY=
══ DATABASE (auto-set by CDK — leave blank) ══
DATABASE_URL=                          # after V17: connect as sales_app_login (scripts/db/create_app_login.sh), NOT the superuser — superusers bypass tenant isolation
REDIS_URL=
══ MULTI-TENANCY (SaaS) ═══════════════════════
AUTH_ORG_ID=                          # optional; default = legacy org 00000000-0000-0000-0000-0000000000a1
CREDENTIALS_KEY=                      # base64 of 32 random bytes; encrypts connected-account secrets. Back it up: losing it = all stored secrets unreadable
SIGNUP_ENABLED=false                  # true = anyone can create an account + org at POST /api/auth/signup
ONBOARDING_AI_CAP=15                  # AI calls the platform pays for per new org during onboarding (uses ANTHROPIC_API_KEY)
DASHBOARD_URL=http://localhost:5173   # public address of the dashboard: invite / reset / verify links point here
PLATFORM_SMTP_HOST=                   # optional: the platform's own mailbox for invitations, password reset, verification
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASS=
PLATFORM_MAIL_FROM=                   # e.g. "AI Sales Agent <no-reply@yourdomain.com>"; without it links are shown to admins instead of emailed
REQUIRE_VERIFIED_EMAIL=true           # launching a campaign needs a verified email (enforced only when platform email is configured)
INVITE_TTL_DAYS=7
STRIPE_SECRET_KEY=                    # optional paid plans (Stripe); without it the dashboard shows usage but no buy buttons
STRIPE_WEBHOOK_SECRET=                # signing secret of the endpoint https://<api>/webhooks/stripe
STRIPE_PRICE_STARTER=                 # a recurring Price id per plan; a plan without one is not for sale
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
GOOGLE_CLIENT_ID=                     # optional "Continue with Google" (OAuth client, type Web application)
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=                  # API's public .../api/auth/google/callback (default: DASHBOARD_URL + that path); register it in Google Cloud
PLATFORM_ADMIN_EMAILS=                # comma-separated; people who run the platform (see all companies). Must verify their email. AUTH_USER_EMAIL always is one
ACCOUNT_RECHECK_ENABLED=true          # hourly re-check of connected accounts that passed Verify (local auth only)
ACCOUNT_RECHECK_INTERVAL_MINUTES=60
ACCOUNT_RECHECK_AGE_HOURS=24
# ── production stack (docker-compose.prod.yml) ──
POSTGRES_PASSWORD=                    # required by the prod compose (only applies when the volume is first created)
APP_DATABASE_URL=                     # DATABASE_URL for api + orchestrator in prod: postgresql://sales_app_login:...@postgres:5432/salesagent
DOMAIN=                               # public host for the optional Caddy edge profile (e.g. app.example.com)
DASHBOARD_API_URL=                    # leave EMPTY when one address serves dashboard + API (recommended)
BACKUP_AGE_RECIPIENT=                 # age PUBLIC key (age-keygen); keep the private key OFFLINE. Backups refuse to run without it
BACKUP_S3_URL=                        # s3://bucket/prefix: the offsite copy (any S3-compatible bucket)
BACKUP_S3_ENDPOINT=                   # only for non-AWS S3 (Hetzner, Backblaze B2, R2, ...)
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=us-east-1
BACKUP_INTERVAL_HOURS=24
# ── monitoring (api) ──
ALERT_WEBHOOK_URL=                    # Slack / Discord / Teams / ntfy incoming webhook: told when a check fails and recovers
ALERT_EMAIL=                          # comma-separated; sent through the platform mailbox
OPS_PING_URL=                         # dead-man's switch (e.g. healthchecks.io): pinged each healthy cycle; THEY alert you if it stops
OPS_EXPECTED_HEARTBEATS=auto_sends:20,poll_replies:30,proc_inbound:30,backup:1560,backup_verified:11520
OPS_DB_SIZE_ALERT_GB=0                # 0 = off
══ AUTH — Cognito (auto-set by CDK) ══════════
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-south-1
══ APP ════════════════════════════════════════
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
DASHBOARD_PORT=5173
ENABLE_RESEARCH_AGENT=      # 1 to enable web-grounded per-prospect research
ENRICHMENT_PROVIDERS=              # ordered: fullenrich,prospeo,datagma
FULLENRICH_API_KEY=
PROSPEO_API_KEY=
DATAGMA_API_KEY=
